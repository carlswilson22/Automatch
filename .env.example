# ==============================================================================
# AutoMatch — Arquivo de Configuração de Ambiente (.env.example)
# ==============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Gere chaves seguras para senhas e segredos usando o comando:
#    openssl rand -hex 32
# 3. NUNCA envie o arquivo .env preenchido para o controle de versão Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS (PostgreSQL 15)
# ------------------------------------------------------------------------------
POSTGRES_DB=automatch
POSTGRES_USER=automatch_user
# Gere uma senha segura com: openssl rand -hex 16
POSTGRES_PASSWORD=altere_para_uma_senha_forte_do_postgres

# URL de conexão do SQLAlchemy utilizada pelo backend
# Formato: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
DATABASE_URL=postgresql://automatch_user:altere_para_uma_senha_forte_do_postgres@db:5432/automatch

# ------------------------------------------------------------------------------
# 2. CACHE & MENSAGERIA (Redis 7)
# ------------------------------------------------------------------------------
# Senha de autenticação do Redis via --requirepass
# Gere com: openssl rand -hex 16
REDIS_PASSWORD=altere_para_uma_senha_forte_do_redis
REDIS_URL=redis://:altere_para_uma_senha_forte_do_redis@redis:6379/0

# ------------------------------------------------------------------------------
# 3. AUTENTICAÇÃO E CRIPTOGRAFIA (JWT)
# ------------------------------------------------------------------------------
# Chave secreta de alta entropia para assinatura HMAC-SHA256 dos tokens JWT
# ATENÇÃO: NUNCA utilize valores padrão como 'secret' ou '123456'
# Gere com: openssl rand -hex 32
JWT_SECRET=gerar_chave_hex_com_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. INTELIGÊNCIA ARTIFICIAL E APIS EXTERNAS
# ------------------------------------------------------------------------------
# Chave do Google AI Studio para perícia visual e assistente virtual
# Obtenha em: https://aistudio.google.com/
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 5. FRONTEND & API GATEWAY
# ------------------------------------------------------------------------------
# URL da API consumida pelo cliente frontend
# Em ambiente local com Gateway Nginx, utilize /api
VITE_API_URL=/api
PORT=8000
