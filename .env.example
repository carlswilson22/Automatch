# ==============================================================================
# AUTOMATCH - ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para um novo arquivo chamado `.env`:
#    cp .env.example .env
# 2. Preencha as variáveis abaixo com os valores reais do seu ambiente local.
# 3. NUNCA envie o arquivo `.env` preenchido para o GitHub/repositório.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AMBIENTE E SERVIDOR
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PORT=8000
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS (PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://usuario:senha@localhost:5432/banco
POSTGRES_USER=usuario
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DB=banco

# ------------------------------------------------------------------------------
# 3. INTELIGÊNCIA ARTIFICIAL & APIS EXTERNAS
# ------------------------------------------------------------------------------
# Obtenha sua chave gratuita em: https://aistudio.google.com/
GEMINI_API_KEY=insira_sua_chave_aqui

# ------------------------------------------------------------------------------
# 4. AUTENTICAÇÃO E SEGURANÇA (JWT)
# ------------------------------------------------------------------------------
# Gere um segredo forte (ex: openssl rand -hex 32)
JWT_SECRET=insira_seu_jwt_secret_aqui
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 5. FRONTEND (Vite / React)
# ------------------------------------------------------------------------------
# Variáveis que precisam ser acessíveis no navegador DEVEM ter o prefixo VITE_
VITE_API_BASE_URL=http://localhost:3000/api
VITE_ENABLE_AI_SCANNER=true
VITE_APP_NAME=Automatch
