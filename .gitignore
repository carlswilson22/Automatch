# ==============================================================================
# .gitignore Definitivo - Stack: Python (FastAPI) + Node.js (React/Vite) + Docker
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SEGREDOS, CREDENCIAIS E VARIÁVEIS DE AMBIENTE LOCAIS (CRÍTICO)
# ------------------------------------------------------------------------------
*.env
*.env.*
!.env.example
!.env.template
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
secrets.json
credentials.json
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# 2. DEPENDÊNCIAS PESADAS E AMBIENTES VIRTUAIS
# ------------------------------------------------------------------------------
# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python Virtual Environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. COMPILADOS, BUILDS, BUNDLES E ARQUIVOS TEMPORÁRIOS
# ------------------------------------------------------------------------------
# Frontend (Vite / React)
dist/
dist-ssr/
build/
*.local

# Python / FastAPI
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Testes e Cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# ------------------------------------------------------------------------------
# 4. BANCO DE DADOS LOCAL E ARQUIVOS DE DOCKER/VOLUME
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
automatch_postgres_data/
postgres-data/

# ------------------------------------------------------------------------------
