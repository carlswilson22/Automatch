# ==============================================================================
# AutoMatch — Configuração de Produção (.env.production.example)
# ==============================================================================
# INSTRUÇÕES PARA DEPLOY EM PRODUÇÃO:
# 1. Copie este arquivo para .env no servidor de produção:
#    cp .env.production.example .env
# 2. Gere segredos criptográficos fortes (mínimo 32 bytes hex) com o comando:
#    openssl rand -hex 32
#    OU no PowerShell:
#    -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
# 3. NUNCA utilize senhas padrão, "changeme", "dev", etc. O backend abortará a
#    inicialização se detectar chaves fracas em produção (R2 Security Guard).
# 4. Certifique-se de que este arquivo tenha permissões restritas (chmod 600 .env).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AMBIENTE
# ------------------------------------------------------------------------------
ENVIRONMENT=production
# Em produção, DATABASE_MODE=sqlite É ESTRITAMENTE PROIBIDO e causará erro fatal.
DATABASE_MODE=postgres

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS (PostgreSQL 15 - Container interno ou Gerenciado RDS/CloudSQL)
# ------------------------------------------------------------------------------
POSTGRES_DB=automatch_prod
POSTGRES_USER=automatch_app
# Senha forte gerada aleatoriamente:
POSTGRES_PASSWORD=gere_uma_senha_muito_forte_com_openssl_rand_hex_32

# URL de conexão do SQLAlchemy utilizada pelo backend
# Se usar o container db do docker-compose.prod.yml:
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
# Se usar banco gerenciado externo (AWS RDS, Supabase, Neon):
# DATABASE_URL=postgresql://usuario:senha@seu-host-rds.com:5432/nome_banco

# ------------------------------------------------------------------------------
# 3. AUTENTICAÇÃO E CRIPTOGRAFIA (JWT & OWASP R2)
# ------------------------------------------------------------------------------
# Segredo HMAC-SHA256 de alta entropia. OBRIGATÓRIO ter pelo menos 32 caracteres.
# O sistema falha no startup se for deixado em branco ou com valor de exemplo.
JWT_SECRET=substitua_por_uma_chave_secreta_forte_de_32_bytes_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Proíbe tokens de demonstração e bypass de autorização em produção
ALLOW_DEMO_TOKENS=false

# ------------------------------------------------------------------------------
# 4. INTELIGÊNCIA ARTIFICIAL (Google Gemini API)
# ------------------------------------------------------------------------------
# Chave de produção do Google AI Studio para perícia visual e assistente
# Obtenha em: https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_gemini_api_de_producao

# ------------------------------------------------------------------------------
# 5. FRONTEND & GATEWAY
# ------------------------------------------------------------------------------
# O gateway Nginx roteia /api para o backend internamente.
# Para o frontend compilado, use caminhos relativos:
VITE_API_URL=/api
PORT=8000
