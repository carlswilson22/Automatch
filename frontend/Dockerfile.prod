# Stage 1: Build da SPA React
FROM node:20-alpine AS builder

WORKDIR /app

# Instala dependencias com cache de camadas
COPY package.json package-lock.json ./
RUN npm ci || npm install

# Copia codigo e compila bundle otimizado
COPY . .
RUN npm run build

# Stage 2: Runtime leve com Nginx Alpine (< 25MB)
FROM nginx:alpine

# Copia o bundle gerado
COPY --from=builder /app/dist /usr/share/nginx/html

# Copia configuracao Nginx otimizada para SPA
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
