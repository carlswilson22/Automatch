# ==============================================================================
# frontend/Dockerfile.prod — Build de produção multi-estágio e servidor Nginx.
#
# Objetivo e Motivo da Criação:
#   - Compila o bundle estático do Vite e serve os arquivos otimizados através de um servidor Nginx leve.
# ==============================================================================
# Stage 1: Build da SPA React
FROM node:20-alpine AS builder

WORKDIR /app

# Argumento para base path customizável no build (padrão raiz '/')
ARG VITE_BASE_PATH=/
ENV VITE_BASE_PATH=$VITE_BASE_PATH

# Instala dependencias com cache de camadas
COPY package.json package-lock.json ./
RUN npm ci || npm install

# Copia codigo e compila bundle otimizado
COPY . .
RUN npm run build

# Stage 2: Runtime leve com Nginx Alpine (< 25MB)
FROM nginx:alpine

# Copia o bundle gerado
COPY --from=builder /app/dist /usr/share/nginx/html

# Copia configuracao Nginx otimizada para SPA
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
